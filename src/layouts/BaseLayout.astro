---
import { ClientRouter } from "astro:transitions";
import { Navbar } from "../components/Navbar";
import "../styles/global.css";

interface Props {
  locale: "es" | "en";
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const basePath = Astro.url.pathname.replace(/^\/(es|en)/, "") || "/";
const esURL = new URL(`/es${basePath === "/" ? "" : basePath}`, Astro.site).toString();
const enURL = new URL(`/en${basePath === "/" ? "" : basePath}`, Astro.site).toString();
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Alejandro Flores Morales" />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "es" ? "en_US" : "es_ES"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Theme inline script to prevent flash -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem("theme");
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored || (systemDark ? "dark" : "light");
        if (theme === "light") {
          document.documentElement.classList.add("light");
          document.documentElement.classList.remove("dark");
        } else {
          document.documentElement.classList.add("dark");
          document.documentElement.classList.remove("light");
        }
      })();
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Alejandro Flores Morales",
      url: Astro.site,
      sameAs: [
        "https://github.com/alexfloresmorales26-cmyk",
        "https://www.linkedin.com/in/alejandro-flores-morales-undefined-50035144b/",
      ],
      jobTitle: "Computer Systems Engineering Student",
      worksFor: {
        "@type": "Organization",
        name: "Freelance",
      },
      knowsAbout: ["Computer Systems Engineering", "Software Development", "Python", "Java", "Algorithms", "Data Structures", "Linux Mint", "Linux", "Git", "GitHub", "Backend Development", "React", "Astro", "TypeScript", "Tailwind CSS"],
    }, null, 2)} />

    <title>{title} | Alejandro Flores Morales</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-bg text-text antialiased">
    <ClientRouter />
    <Navbar locale={locale} client:load />
    <main id="main-content">
      <slot />
    </main>
    <footer class="border-t border-border py-8 px-6">
      <div class="max-w-7xl mx-auto text-center text-text-muted text-sm font-mono">
        <p>{locale === "es" ? "Todos los derechos reservados." : "All rights reserved."}</p>
        <p class="mt-1">{locale === "es" ? "Hecho con ❤️ y mucho neón" : "Made with ❤️ and lots of neon"}</p>
      </div>
    </footer>
  </body>
</html>
