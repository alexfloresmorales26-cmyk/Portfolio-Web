---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { es } from "../../i18n/translations/es";

const locale = "es";
const t = es;

const schoolProjects = [
  {
    title: "Sistema de Gestión Escolar",
    desc: "Plataforma para administración de notas, asistencia y horarios de alumnos.",
    tech: ["React", "Node.js", "MySQL", "Tailwind"],
    link: "https://github.com/alexfloresmorales26-cmyk",
  },
  {
    title: "E-Commerce Académico",
    desc: "Tienda en línea para venta de materiales escolares con pasarela de pago.",
    tech: ["Astro", "TypeScript", "Stripe", "Tailwind"],
    link: "https://github.com/alexfloresmorales26-cmyk",
  },
  {
    title: "App de Tareas (To-Do)",
    desc: "Aplicación de productividad con sincronización en tiempo real.",
    tech: ["React", "Firebase", "Tailwind"],
    link: "https://github.com/alexfloresmorales26-cmyk",
  },
];

const personalProjects = [
  {
    title: "Portafolio Web Personal",
    desc: "Este sitio web desarrollado con Astro, Tailwind v4 y Framer Motion.",
    tech: ["Astro", "Tailwind", "Framer Motion", "MDX"],
    link: "https://github.com/alexfloresmorales26-cmyk/Portfolio-Web",
  },
  {
    title: "Dashboard de Productividad",
    desc: "Tablero personal para organización de tareas y seguimiento de hábitos.",
    tech: ["React", "TypeScript", "Tailwind", "LocalStorage"],
    link: "https://github.com/alexfloresmorales26-cmyk",
  },
];

export const prerender = true;
---

<BaseLayout
  locale={locale}
  title={t.projects.title}
  description={t.projects.subtitle}
>
  <section class="py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-6xl font-extrabold text-text mb-4">{t.projects.title}</h2>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">{t.projects.subtitle}</p>
      </div>

      {/* Proyectos Escolares */}
      <section class="mb-20 border-glow p-8">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h3 class="text-2xl font-bold text-text">{t.projects.school}</h3>
            <p class="text-text-muted text-sm">{t.projects.schoolDesc}</p>
          </div>
          <a
            href="https://github.com/alexfloresmorales26-cmyk"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neon-cyan text-sm font-medium hover:text-neon-cyan/80 transition-colors"
          >
            Ver todos →
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {schoolProjects.map((p) => (
            <div class="border-glow p-6 hover:border-neon-cyan/50 transition-all group">
              <div class="h-32 bg-surface-hover rounded-xl border border-border mb-4 flex items-center justify-center text-text-muted text-sm font-mono">
                {p.title}
              </div>
              <p class="text-sm text-text-muted mb-4 line-clamp-3">{p.desc}</p>
              <div class="flex flex-wrap gap-2 mb-4">
                {p.tech.map((tech) => (
                  <span class="px-2 py-1 bg-surface border border-border rounded text-xs font-mono text-neon-cyan">{tech}</span>
                ))}
              </div>
              <a
                href={p.link}
                class="w-full py-2 border border-neon-cyan text-neon-cyan text-sm font-semibold rounded hover:bg-neon-cyan hover:text-bg transition-all inline-block text-center"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.projects.viewProject}
              </a>
            </div>
          ))}
        </div>
      </section>

      {/* Proyectos Personales */}
      <section class="border-glow p-8">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h3 class="text-2xl font-bold text-text">{t.projects.personal}</h3>
            <p class="text-text-muted text-sm">{t.projects.personalDesc}</p>
          </div>
          <a
            href="https://github.com/alexfloresmorales26-cmyk"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neon-cyan text-sm font-medium hover:text-neon-cyan/80 transition-colors"
          >
            Ver todos →
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {personalProjects.map((p) => (
            <div class="border-glow p-6 hover:border-neon-magenta/50 transition-all group">
              <div class="h-32 bg-surface-hover rounded-xl border border-border mb-4 flex items-center justify-center text-text-muted text-sm font-mono">
                {p.title}
              </div>
              <p class="text-sm text-text-muted mb-4 line-clamp-3">{p.desc}</p>
              <div class="flex flex-wrap gap-2 mb-4">
                {p.tech.map((tech) => (
                  <span class="px-2 py-1 bg-surface border border-border rounded text-xs font-mono text-neon-cyan">{tech}</span>
                ))}
              </div>
              <a
                href={p.link}
                class="w-full py-2 border border-neon-magenta text-neon-magenta text-sm font-semibold rounded hover:bg-neon-magenta hover:text-bg transition-all inline-block text-center"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.projects.viewProject}
              </a>
            </div>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
