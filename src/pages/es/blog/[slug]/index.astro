---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getCollection, getEntryBySlug, render } from "astro:content";
import { es } from "../../../../content/config/translations/es";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { locale, post } = Astro.props;
const t = es;
const { Content, headings } = await render(post);

export const prerender = true;
---

<BaseLayout locale={locale as "es" | "en"} title={post.data.title} description={post.data.description}>
  <article class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <header class="mb-12">
        <time class="text-text-muted text-sm font-mono mb-4 block">
          {post.data.pubDate.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <h1 class="text-4xl md:text-5xl font-extrabold text-text mb-6">{post.data.title}</h1>
        <p class="text-lg text-text-muted max-w-2xl">{post.data.description}</p>
        {post.data.readingTime && (
          <p class="mt-4 text-sm text-text-muted font-mono">{post.data.readingTime} min de lectura</p>
        )}
      </header>

      <div class="grid lg:grid-cols-4 gap-12">
        <aside class="lg:col-span-1 hidden lg:block">
          <nav class="sticky top-24 space-y-2 max-h-[60vh] overflow-y-auto pr-4">
            <h4 class="text-xs font-bold text-text-muted uppercase tracking-wider mb-4">En esta página</h4>
            <ul class="space-y-1">
              {headings
                .filter((h) => h.depth === 2)
                .map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="text-sm text-text-muted hover:text-neon-cyan transition-colors block py-1"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
            </ul>
          </nav>
        </aside>

        <div class="lg:col-span-3 prose prose-invert max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  body { margin: 0; font-family: 'Space Grotesk', sans-serif; background: #050507; color: #fff; }
  a { color: #22d3ee; text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>