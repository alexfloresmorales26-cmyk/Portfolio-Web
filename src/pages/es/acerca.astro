---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { es } from "../../i18n/translations/es";

const locale = "es";
const t = es;

const technicalStrengths = {
  languages: [
    { name: "Python", highlight: true },
    { name: "Java", highlight: true },
    { name: "JavaScript", highlight: false },
    { name: "TypeScript", highlight: false },
    { name: "SQL", highlight: false },
    { name: "HTML5 / CSS3", highlight: false },
  ],
  areas: [
    { title: "Lógica de Programación", desc: "Resolución sistemática de problemas y razonamiento algorítmico." },
    { title: "Estructuras de Datos", desc: "Manejo y optimización de listas, árboles, grafos y colecciones." },
    { title: "Desarrollo Backend & Web", desc: "Arquitectura de software, APIs y aplicaciones web estructuradas." },
    { title: "Automatización & Scripting", desc: "Automatización de tareas repetitivas y scripts de productividad." },
  ],
  tools: [
    { name: "Git & GitHub", highlight: true },
    { name: "Terminal / Bash", highlight: true },
    { name: "Editores (VS Code)", highlight: false },
    { name: "Astro & React", highlight: false },
  ],
};

export const prerender = true;
---

<BaseLayout
  locale={locale}
  title={t.about.title}
  description={`${t.about.name} - ${t.about.role}`}
>
  <section class="relative min-h-[90vh] px-6 pt-28 pb-16">
    {/* Decoración de fondo */}
    <div class="absolute inset-0 -z-10 opacity-30 pointer-events-none">
      <div class="absolute top-1/6 left-1/6 w-80 h-80 border border-neon-cyan/20 rounded-full animate-pulse"></div>
      <div class="absolute bottom-1/4 right-1/6 w-96 h-96 border border-neon-magenta/20 rounded-full animate-pulse" style="animation-delay: 1.5s"></div>
    </div>

    <div class="max-w-6xl mx-auto space-y-12">
      {/* Tarjeta Principal de Perfil */}
      <div class="border-glow p-8 md:p-12 relative overflow-hidden">
        <div class="grid lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-4 flex flex-col items-center text-center">
            <div class="w-44 h-44 rounded-2xl overflow-hidden border-2 border-neon-cyan/50 shadow-[0_0_30px_rgba(34,211,238,0.3)] mb-4 relative group">
              <img
                src="/images/profile.jpg"
                alt={t.about.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <h2 class="text-2xl font-extrabold text-text">{t.about.name}</h2>
            <p class="text-neon-cyan font-semibold text-sm mt-1">{t.about.role}</p>
          </div>

          <div class="lg:col-span-8 space-y-4">
            <div class="border-l-4 border-neon-cyan pl-4 py-1">
              <h3 class="text-xl md:text-2xl font-bold text-text leading-snug">
                "Estudiante de Ingeniería en Sistemas Computacionales | Apasionado por la lógica, el desarrollo de software y la optimización de código."
              </h3>
            </div>
            <p class="text-text-muted leading-relaxed text-base pt-2">
              {t.about.bio}
            </p>
            <div class="flex flex-wrap gap-3 pt-2">
              <span class="px-3.5 py-1.5 bg-surface border border-neon-cyan/30 text-neon-cyan rounded-lg text-xs font-mono font-medium">
                🐧 Linux & Software Libre
              </span>
              <span class="px-3.5 py-1.5 bg-surface border border-neon-green/30 text-neon-green rounded-lg text-xs font-mono font-medium">
                ⚡ Práctica Diaria: Python & Java
              </span>
              <span class="px-3.5 py-1.5 bg-surface border border-neon-magenta/30 text-neon-magenta rounded-lg text-xs font-mono font-medium">
                🧩 Lógica & Algoritmos
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Grid: Educación y Metodología */}
      <div class="grid md:grid-cols-2 gap-8">
        <div class="border-glow p-8">
          <h3 class="text-xl font-bold text-text mb-4 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-neon-cyan rounded-full"></span>
            {t.about.education}
          </h3>
          <div class="space-y-2">
            <p class="text-lg font-semibold text-text">{t.about.educationSchool}</p>
            <p class="text-neon-cyan font-mono text-sm">{t.about.educationDegree}</p>
            <p class="text-text-muted text-sm leading-relaxed pt-2">
              Formación académica enfocada en la computación, arquitectura de sistemas, matemática aplicada y desarrollo de software robusto.
            </p>
          </div>
        </div>

        <div class="border-glow p-8">
          <h3 class="text-xl font-bold text-text mb-4 flex items-center gap-2">
            <span class="w-1.5 h-6 bg-neon-magenta rounded-full"></span>
            {t.about.experience}
          </h3>
          <div class="space-y-2">
            <p class="text-lg font-semibold text-text">{t.about.experienceTitle}</p>
            <p class="text-text-muted text-sm leading-relaxed">
              {t.about.experienceDesc}
            </p>
            <p class="text-text-muted text-sm leading-relaxed pt-2">
              Dedicación diaria al aprendizaje autodidacta y la creación de soluciones prácticas para consolidar una base de ingeniería sólida.
            </p>
          </div>
        </div>
      </div>

      {/* Fortalezas Técnicas Actuales */}
      <div class="space-y-8">
        <div class="text-center md:text-left">
          <h3 class="text-2xl md:text-3xl font-extrabold text-text flex items-center justify-center md:justify-start gap-3">
            <span class="w-2 h-7 bg-neon-green rounded-full"></span>
            {t.about.skills}
          </h3>
          <p class="text-text-muted text-sm mt-1">Herramientas, tecnologías y áreas de especialización activa</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {/* Lenguajes */}
          <div class="border-glow p-6 space-y-4">
            <h4 class="text-base font-bold text-text flex items-center gap-2">
              <span class="text-neon-cyan font-mono text-lg">{'{ }'}</span>
              {t.about.languagesTitle}
            </h4>
            <div class="flex flex-wrap gap-2">
              {technicalStrengths.languages.map((lang) => (
                <span
                  class={`px-3 py-1.5 rounded-lg text-xs font-mono transition-all ${
                    lang.highlight
                      ? "bg-neon-cyan/10 border border-neon-cyan text-neon-cyan font-bold shadow-[0_0_12px_rgba(34,211,238,0.2)]"
                      : "bg-surface-hover border border-border text-text-muted hover:border-text-muted"
                  }`}
                >
                  {lang.name}
                </span>
              ))}
            </div>
          </div>

          {/* Áreas de Interés */}
          <div class="border-glow p-6 space-y-4">
            <h4 class="text-base font-bold text-text flex items-center gap-2">
              <span class="text-neon-magenta font-mono text-lg">✦</span>
              {t.about.areasTitle}
            </h4>
            <ul class="space-y-3">
              {technicalStrengths.areas.map((area) => (
                <li class="border-b border-border/40 pb-2 last:border-b-0 last:pb-0">
                  <p class="text-xs font-bold text-neon-magenta">{area.title}</p>
                  <p class="text-xs text-text-muted mt-0.5">{area.desc}</p>
                </li>
              ))}
            </ul>
          </div>

          {/* Entornos Linux y Herramientas */}
          <div class="border-glow p-6 space-y-4">
            <h4 class="text-base font-bold text-text flex items-center gap-2">
              <span class="text-neon-green font-mono text-lg">🐧</span>
              {t.about.toolsTitle}
            </h4>

            <div class="p-3.5 bg-surface/80 rounded-xl border border-neon-green/30 space-y-1.5 shadow-[0_0_15px_rgba(52,211,153,0.1)]">
              <p class="text-xs font-bold text-neon-green flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-neon-green"></span>
                {t.about.linuxTitle}:
              </p>
              <p class="text-xs text-text-muted leading-relaxed">
                {t.about.linuxDesc}
              </p>
            </div>

            <div class="space-y-2 pt-1">
              <p class="text-[11px] font-mono uppercase tracking-wider text-text-muted font-semibold">Herramientas clave</p>
              <div class="flex flex-wrap gap-2">
                {technicalStrengths.tools.map((tool) => (
                  <span
                    class={`px-3 py-1.5 rounded-lg text-xs font-mono transition-all ${
                      tool.highlight
                        ? "bg-neon-green/10 border border-neon-green text-neon-green font-bold shadow-[0_0_12px_rgba(52,211,153,0.2)]"
                        : "bg-surface-hover border border-border text-text-muted hover:border-text-muted"
                    }`}
                  >
                    {tool.name}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
