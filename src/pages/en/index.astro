---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Hero } from "@/components/Hero";
import { en } from "@/content/config/translations/en";

const { locale } = Astro.params;
const t = en;

export const prerender = true;
---

<BaseLayout locale={locale as "es" | "en"} title={t.hero.intro} description={t.hero.subtitle}>
  <section class="relative min-h-screen flex flex-col items-center justify-center px-6 pt-16">
    <Hero
      t={(key: string) => {
        const parts = key.split(".");
        let val: any = t;
        for (const part of parts) val = val?.[part];
        return typeof val === "string" ? val : key;
      }}
      locale={locale as "es" | "en"}
    />
  </section>
</BaseLayout>

<style is:global>
  body { margin: 0; font-family: 'Space Grotesk', sans-serif; background: #050507; color: #fff; }
  a { color: #22d3ee; text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
