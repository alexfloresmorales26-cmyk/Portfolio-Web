---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { es } from "@/content/config/translations/es";
import { en } from "@/content/config/translations/en";

const { locale } = Astro.params;
const dict = locale === "en" ? en : es;
const t = dict;

const schoolProjects = [
  {
    title: "School Management System",
    desc: "Platform for managing student grades, attendance and schedules.",
    tech: ["React", "Node.js", "MySQL", "Tailwind"],
    link: "#",
  },
  {
    title: "Academic E-Commerce",
    desc: "Online store for selling school supplies with payment gateway.",
    tech: ["Astro", "TypeScript", "Stripe", "Tailwind"],
    link: "#",
  },
  {
    title: "To-Do App",
    desc: "Productivity app with real-time synchronization.",
    tech: ["React", "Firebase", "Tailwind"],
    link: "#",
  },
];

const personalProjects = [
  {
    title: "Personal Portfolio Website",
    desc: "This website built with Astro, Tailwind v4 and Framer Motion.",
    tech: ["Astro", "Tailwind", "Framer Motion", "MDX"],
    link: "#",
  },
  {
    title: "Productivity Dashboard",
    desc: "Personal dashboard for task organization and habit tracking.",
    tech: ["React", "TypeScript", "Tailwind", "LocalStorage"],
    link: "#",
  },
];

export const prerender = true;
---

<BaseLayout
  locale={locale as "es" | "en"}
  title={t.projects.title}
  description={t.projects.subtitle}
>
  <section class="py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-6xl font-extrabold text-text mb-4">{t.projects.title}</h2>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">{t.projects.subtitle}</p>
      </div>

      {/* School Projects */}
      <section class="mb-20 border-glow p-8">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h3 class="text-2xl font-bold text-text">{t.projects.school}</h3>
            <p class="text-text-muted text-sm">{t.projects.schoolDesc}</p>
          </div>
          <a
            href="#"
            class="text-neon-cyan text-sm font-medium hover:text-neon-cyan/80 transition-colors"
          >
            View all →
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {schoolProjects.map((p) => (
            <div class="border-glow p-6 hover:border-neon-cyan/50 transition-all group">
              <div class="h-32 bg-surface-hover rounded-xl border border-border mb-4 flex items-center justify-center text-text-muted text-sm font-mono">
                {p.title}
              </div>
              <p class="text-text-sm text-text-muted mb-4 line-clamp-3">{p.desc}</p>
              <div class="flex flex-wrap gap-2 mb-4">
                {p.tech.map((tech) => (
                  <span class="px-2 py-1 bg-surface border border-border rounded text-xs font-mono text-neon-cyan">{tech}</span>
                ))}
              </div>
              <a
                href={p.link}
                class="w-full py-2 border border-neon-cyan text-neon-cyan text-sm font-semibold rounded hover:bg-neon-cyan hover:text-bg transition-all"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.projects.viewProject}
              </a>
            </div>
          ))}
        </div>
      </section>

      {/* Personal Projects */}
      <section class="border-glow p-8">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h3 class="text-2xl font-bold text-text">{t.projects.personal}</h3>
            <p class="text-text-muted text-sm">{t.projects.personalDesc}</p>
          </div>
          <a
            href="#"
            class="text-neon-cyan text-sm font-medium hover:text-neon-cyan/80 transition-colors"
          >
            View all →
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {personalProjects.map((p) => (
            <div class="border-glow p-6 hover:border-neon-magenta/50 transition-all group">
              <div class="h-32 bg-surface-hover rounded-xl border border-border mb-4 flex items-center justify-center text-text-muted text-sm font-mono">
                {p.title}
              </div>
              <p class="text-text-sm text-text-muted mb-4 line-clamp-3">{p.desc}</p>
              <div class="flex flex-wrap gap-2 mb-4">
                {p.tech.map((tech) => (
                  <span class="px-2 py-1 bg-surface border border-border rounded text-xs font-mono text-neon-cyan">{tech}</span>
                ))}
              </div>
              <a
                href={p.link}
                class="w-full py-2 border border-neon-magenta text-neon-magenta text-sm font-semibold rounded hover:bg-neon-magenta hover:text-bg transition-all"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.projects.viewProject}
              </a>
            </div>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style is:global>
  body { margin: 0; font-family: 'Space Grotesk', sans-serif; background: #050507; color: #fff; }
  a { color: #22d3ee; text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
