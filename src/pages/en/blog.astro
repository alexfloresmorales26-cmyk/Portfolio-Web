---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { en } from "../../i18n/translations/en";

const locale = "en";
const t = en;

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

export const prerender = true;
---

<BaseLayout locale={locale} title={t.blog.title} description={t.blog.subtitle}>
  <section class="py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-6xl font-extrabold text-text mb-4">{t.blog.title}</h2>
        <p class="text-lg text-text-muted">{t.blog.subtitle}</p>
      </div>

      {posts.length === 0 ? (
        <div class="text-center py-20 border-glow">
          <p class="text-text-muted text-lg">{t.blog.noPosts}</p>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 gap-8">
          {posts.map((post) => (
            <a
              href={`/en/blog/${post.id}`}
              class="border-glow p-6 hover:border-neon-cyan/50 transition-all group block"
            >
              <h3 class="text-xl font-bold text-text mb-2 group-hover:text-neon-cyan transition-colors">
                {post.data.title}
              </h3>
              <p class="text-text-muted text-sm mb-4 line-clamp-2">{post.data.description}</p>
              <div class="flex items-center gap-4 text-xs text-text-muted font-mono">
                <time>{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
                {post.data.readingTime && <span>{post.data.readingTime} min read</span>}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
